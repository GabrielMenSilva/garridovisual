{
  "name": "garridovisual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.14.0",
    "heic-convert": "^2.1.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^12.8.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs dist dist-ssr",
    "preview": "vite preview --port 4173 --strictPort",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm build:e2e && playwright test --project=chromium-desktop --project=chromium-mobile && playwright test --project=webkit-desktop --project=webkit-mobile --workers=2",
    "assets:download": "node scripts/baixar-imagens.mjs",
    "assets:optimize": "node scripts/otimizar-imagens.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e && vite build --mode e2e --ssr src/entry-server.tsx --outDir dist-ssr-e2e && node scripts/prerender.mjs dist-e2e dist-ssr-e2e",
    "media:inventory": "node scripts/inventariar-midia.mjs",
    "media:import": "node scripts/importar-midia.mjs"
  }
}
